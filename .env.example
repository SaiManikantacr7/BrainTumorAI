# ==========================================
# NEUROSCAN AI - Environment Configuration
# ==========================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME="NeuroScan AI Platform"
APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Security
SECRET_KEY=neuroscan_super_secret_jwt_key_replace_in_production_98374982739482734
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default: zero-config SQLite for instant local development
# Production: postgresql://neuroscan_user:password@localhost:5432/neuroscan_db
DATABASE_URL=sqlite:///./neuroscan.db

# SMTP Email Configuration (Gmail App Password)
# Note: In production or for real Gmail sending, generate an "App Password" in Google Account -> Security -> 2-Step Verification -> App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@neuroscan.ai
SMTP_FROM_NAME="NeuroScan AI Research"
SMTP_TLS=True

# OTP Security Parameters
OTP_EXPIRE_MINUTES=5
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# AI Model Inference Settings
MODEL_DEVICE=cpu
DEFAULT_MODEL_VERSION=v1.3.0
ENABLE_GPU=False

# Storage Configuration
STORAGE_TYPE=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

